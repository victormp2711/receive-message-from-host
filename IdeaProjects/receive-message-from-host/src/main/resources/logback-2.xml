<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <appender name="SPRING_LOGS" class="ch.qos.logback.core.FileAppender">
    <file>logs/spring.log</file>
    <encoder>
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <appender name="STDOUT" class="ch.qos.logback.core.FileAppender">
    <file>logs/receive-message-from-host.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <!-- rollover monthly -->
      <fileNamePattern>receive-message-from-host.log-%d{yyyy-MM}.log.zip</fileNamePattern>
      <maxHistory>12</maxHistory>
      <totalSizeCap>3GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %d{HH:mm:ss.SSS} [%26thread] %-5level %-38logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="info">
    <appender-ref ref="STDOUT" />
  </root>
  <logger name="receive-message-from-host" level="INFO"/>
</configuration>
