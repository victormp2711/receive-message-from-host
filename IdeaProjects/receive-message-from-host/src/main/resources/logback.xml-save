<?xml version="1.0" encoding="UTF-8"?>

<configuration>

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <file>logs/myApp.log</file>
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss} %d{HH:mm:ss.SSS} [%26thread] %-5level %-38logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<logger name="io.vertx" level="info" />

	<root level="info">
		<appender-ref ref="STDOUT" />
	</root>
  <logger name="receive-message-from-host" level="INFO"/>
</configuration>
